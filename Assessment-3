import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")

# ---------- 1. Load & clean ----------
df = pd.read_csv(
    r"File_address",
    parse_dates=["Date"]
)
print("Shape:", df.shape)
print("Missing values:\n", df.isna().sum()[lambda s: s > 0])

df["Region"] = df["Region"].fillna("Unknown")
m = df["Discount"].isna()  
df.loc[m, "Discount"] = (1 - df.loc[m, "Sales"] / (df.loc[m, "Quantity"] * df.loc[m, "Unit_Price"])).round(2)
df["Month"] = df["Date"].dt.to_period("M").dt.to_timestamp()
print(df.describe().round(2))

# ---------- 2. Distribution: Sales per order ----------
fig, ax = plt.subplots(1, 2, figsize=(12, 4.5))
sns.histplot(df["Sales"], bins=30, kde=True, color="#4C78A8", ax=ax[0])
ax[0].axvline(df["Sales"].median(), color="red", ls="--", label=f"Median = {df['Sales'].median():,.0f}")
ax[0].axvline(df["Sales"].mean(), color="black", ls="--", label=f"Mean = {df['Sales'].mean():,.0f}")
ax[0].set(title="Distribution of Sales per Order", xlabel="Sales (per order)", ylabel="Number of orders")
ax[0].legend()
sns.histplot(np.log10(df["Sales"]), bins=25, kde=True, color="#F58518", ax=ax[1])
ax[1].set(title="Distribution of Sales (log10 scale)", xlabel="log10(Sales)", ylabel="Number of orders")
plt.tight_layout()
plt.savefig("01_sales_distribution.png", dpi=200, bbox_inches="tight")
plt.show()
print("Interpretation: Sales is right-skewed (skew = %.2f); mean >> median, a few big orders pull the average up.\n" % df["Sales"].skew())

# ---------- 3. Comparison: Sales & Profit by Category ----------
cat = df.groupby("Category")[["Sales", "Profit"]].sum().sort_values("Sales", ascending=False)
cat["Margin %"] = (cat["Profit"] / cat["Sales"] * 100).round(1)
print(cat)
ax = cat[["Sales", "Profit"]].plot(kind="bar", figsize=(9, 5), color=["#4C78A8", "#54A24B"], width=0.75)
ax.set(title="Total Sales and Profit by Category", xlabel="Category", ylabel="Amount")
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig("02_category_comparison.png", dpi=200, bbox_inches="tight")
plt.show()
print("Interpretation: Furniture (~61%) and Electronics (~33%) dominate sales; margins are similar (23-26%).\n")

# ---------- 4. Relationship: Sales vs Profit ----------
clean = df.dropna(subset=["Profit"])
plt.figure(figsize=(8, 5.5))
sns.scatterplot(data=df, x="Sales", y="Profit", hue="Category", alpha=0.8, s=55)
slope, intercept = np.polyfit(clean["Sales"], clean["Profit"], 1)
xs = np.linspace(0, clean["Sales"].max(), 100)
plt.plot(xs, slope * xs + intercept, color="black", ls="--", lw=1.2, label="Linear trend")
plt.title("Relationship between Sales and Profit")
plt.xlabel("Sales (per order)")
plt.ylabel("Profit (per order)")
plt.legend()
plt.tight_layout()
plt.savefig("03_sales_vs_profit.png", dpi=200, bbox_inches="tight")
plt.show()
print("Pearson r = %.2f" % clean["Sales"].corr(clean["Profit"]))
print("Interpretation: strong positive relation; spread widens for large orders (margins vary on big tickets).\n")

# ---------- 5. Correlation heatmap ----------
corr = df[["Quantity", "Unit_Price", "Discount", "Sales", "Profit"]].corr()
plt.figure(figsize=(7, 5.5))
sns.heatmap(corr, annot=True, fmt=".2f", cmap="coolwarm", vmin=-1, vmax=1, linewidths=0.5, square=True)
plt.title("Correlation Heatmap of Numerical Variables")
plt.tight_layout()
plt.savefig("04_correlation_heatmap.png", dpi=200, bbox_inches="tight")
plt.show()
print("Interpretation: Sales depends on Unit_Price (0.84), not Quantity (0.31); Discount is weakly negative with Sales/Profit.\n")

# ---------- 6. Line chart: monthly trend ----------
monthly = df.groupby("Month")[["Sales", "Profit"]].sum()
plt.figure(figsize=(10, 4.8))
plt.plot(monthly.index, monthly["Sales"], marker="o", color="#4C78A8", label="Sales")
plt.plot(monthly.index, monthly["Profit"], marker="s", color="#54A24B", label="Profit")
plt.title("Monthly Sales and Profit Trend (2025)")
plt.xlabel("Month")
plt.ylabel("Amount")
plt.xticks(monthly.index, monthly.index.strftime("%b"))
plt.legend()
plt.tight_layout()
plt.savefig("05_monthly_trend.png", dpi=200, bbox_inches="tight")
plt.show()
print("Interpretation: peak in May (~425k), lowest in Nov (~73k), rebound in Dec.\n")

# ---------- 7. Bonus box plot: Profit by Discount ----------
plt.figure(figsize=(8, 5))
sns.boxplot(data=df, x="Discount", y="Profit", color="#9ecae9")
plt.title("Profit per Order by Discount Level")
plt.xlabel("Discount")
plt.ylabel("Profit (per order)")
plt.tight_layout()
plt.savefig("06_profit_by_discount.png", dpi=200, bbox_inches="tight")
plt.show()
print(df.groupby("Discount")[["Sales", "Profit"]].mean().round(0))
print("Interpretation: average profit per order falls as discount rises (0% ~3.9k vs 15% ~1.6k).")
