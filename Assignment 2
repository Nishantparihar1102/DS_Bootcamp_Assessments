import pandas as pd
import numpy as np

CSV_PATH = r"CSV_File_address"   

# 1. Load and explore
df = pd.read_csv(CSV_PATH)
print(df.shape)
print(df.head())
df.info()
print(df.describe(include="all"))

orig_rows, orig_cols = df.shape
orig_missing = int(df.isna().sum().sum())
orig_dups = int(df.duplicated().sum())
log = []

def add(issue, fix, result):
    log.append({"Issue": issue, "Correction": fix, "Result": result})

# 2-3. Find issues and clean
old = list(df.columns)
df.columns = df.columns.str.strip().str.lower().str.replace(" ", "_")
add("Messy column names", "strip, lower, replace space with _", f"{sum(a != b for a, b in zip(old, df.columns))} renamed")

n = 0
for c in df.select_dtypes(include="object"):
    clean = df[c].str.strip().str.replace(r"\s+", " ", regex=True)
    n += int((df[c].fillna("") != clean.fillna("")).sum())
    df[c] = clean
df = df.replace(["", "N/A", "NULL", "null", "NaN", "na", "-"], np.nan)
add("Extra spaces and fake nulls", "str.strip(), replace with NaN", f"{n} cells trimmed")

num_done, date_done = [], []
formats = ["%d-%m-%Y", "%Y-%m-%d", "%d/%m/%Y", "%m/%d/%Y", "%Y/%m/%d"]
for c in df.select_dtypes(include="object"):
    filled = df[c].notna().sum()
    num = pd.to_numeric(df[c].str.replace(r"[$,€₹£%]", "", regex=True), errors="coerce")
    if filled and num.notna().sum() >= 0.8 * filled:
        df[c] = num
        num_done.append(c)
        continue
    best = max(formats, key=lambda f: pd.to_datetime(df[c], format=f, errors="coerce").notna().sum())
    dates = pd.to_datetime(df[c], format=best, errors="coerce")
    if filled and dates.notna().sum() >= 0.8 * filled:
        df[c] = dates
        date_done.append(c)
add("Numbers stored as text", "remove symbols, to_numeric()", f"{num_done or 'none'}")
add("Dates stored as text", "to_datetime()", f"{date_done or 'none'}")

n = 0
for c in df.select_dtypes(include="object"):
    if df[c].nunique() <= 50:
        new = df[c].str.title()
        n += int((df[c].fillna("") != new.fillna("")).sum())
        df[c] = new
add("Inconsistent text case", "str.title()", f"{n} cells fixed")

keys = ["qty", "quantity", "price", "sales", "amount", "revenue", "units", "total", "cost", "fare", "age"]
n = 0
for c in df.select_dtypes(include="number"):
    if any(k in c for k in keys):
        bad = df[c] < 0
        n += int(bad.sum())
        df.loc[bad, c] = np.nan
add("Invalid negative values", "set to NaN", f"{n} values")

d = int(df.duplicated().sum())
df = df.drop_duplicates().reset_index(drop=True)
add("Duplicate records", "drop_duplicates()", f"{d} rows removed")

m = int(df.isna().sum().sum())
for c in df.columns:
    if pd.api.types.is_numeric_dtype(df[c]) or pd.api.types.is_datetime64_any_dtype(df[c]):
        df[c] = df[c].fillna(df[c].median())
    else:
        df[c] = df[c].fillna("Unknown")
add("Missing values", "median for numbers/dates, 'Unknown' for text", f"{m} filled")

cleaning_log = pd.DataFrame(log)
print(cleaning_log.to_string())

# 4. GroupBy
cats = [c for c in df.select_dtypes(include="object") if 2 <= df[c].nunique() <= 30]
cats.sort(key=lambda c: 0 if any(k in c for k in ["region", "category"]) else 1)
nums = [c for c in df.select_dtypes(include="number") if "id" not in c]
nums.sort(key=lambda c: 0 if any(k in c for k in ["sales", "revenue", "amount", "total"]) else 1)

if cats and nums:
    print(df.groupby(cats[0])[nums[0]].sum().sort_values(ascending=False))

# 5. Pivot table
if len(cats) >= 2 and nums:
    print(pd.pivot_table(df, values=nums[0], index=cats[0], columns=cats[1], aggfunc="sum", fill_value=0))

# 6. Data quality summary
print(f"- Original data: {orig_rows} rows and {orig_cols} columns had {len(cleaning_log)} types of quality issues.")
print("- Cleaning: renamed columns, trimmed text, fixed data types, standardized case, removed invalid values.")
print(f"- Missing values: {orig_missing} found originally and {int(df.isna().sum().sum())} remain after cleaning.")
print(f"- Duplicate records: {orig_dups} found and removed, leaving {len(df)} rows.")
print("- Overall quality: the cleaned dataset is consistent, correctly typed and ready for analysis.")

# 7. Save
df.to_csv("cleaned_data.csv", index=False)
