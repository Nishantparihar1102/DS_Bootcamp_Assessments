print(df["Region"].unique())

print("\nInvalid Prices:")
print(pd.to_numeric(df["UnitPrice"], errors="coerce").le(0).sum())

print("\n3. CLEAN THE DATASET")

cleaned = df.copy()
cleaning_log = []

before = len(cleaned)
cleaned = cleaned.drop_duplicates(subset="OrderID", keep="first")

cleaning_log.append([
    "Duplicate Records",
    "Removed duplicate OrderID values",
    before - len(cleaned)
])

cleaned["OrderDate"] = pd.to_datetime(
    cleaned["OrderDate"],
    format="mixed",
    dayfirst=False,
    errors="coerce"
)

for col in ["Quantity", "UnitPrice", "Sales"]:
    cleaned[col] = pd.to_numeric(cleaned[col], errors="coerce")

cleaning_log.append([
    "Incorrect Data Types",
    "Converted date and numeric columns",
    "Data types corrected"
])

before = len(cleaned)

invalid = (
    (cleaned["Quantity"].notna() & (cleaned["Quantity"] <= 0)) |
    (cleaned["UnitPrice"].notna() & (cleaned["UnitPrice"] <= 0))
)

cleaned = cleaned.loc[~invalid].copy()

cleaning_log.append([
    "Invalid Values",
    "Removed negative or zero quantity and price",
    before - len(cleaned)
])

missing_quantity = cleaned["Quantity"].isnull().sum()
missing_region = cleaned["Region"].isnull().sum()

cleaned["Quantity"] = cleaned["Quantity"].fillna(
    cleaned["Quantity"].median()
).round().astype(int)

cleaned["Region"] = cleaned["Region"].fillna("Unknown")

cleaning_log.append([
    "Missing Values",
    "Filled Quantity with median and Region with Unknown",
    missing_quantity + missing_region
])

for col in ["Region", "ProductCategory", "Product"]:
    cleaned[col] = (
        cleaned[col].astype("string").str.strip().str.title()
    )

cleaning_log.append([
    "Inconsistent Text and Extra Spaces",
    "Applied strip() and title()",
    "Text standardized"
])

cleaned["Sales"] = cleaned["Quantity"] * cleaned["UnitPrice"]

cleaned = cleaned.dropna(
    subset=["OrderDate", "UnitPrice"]
).copy()

cleaning_log.append([
    "Incorrect Sales Values",
    "Recalculated Sales using Quantity multiplied by UnitPrice",
    "Sales corrected"
])

cleaned = cleaned.sort_values("OrderID").reset_index(drop=True)

print("\nCLEANING LOG")

log_df = pd.DataFrame(
    cleaning_log,
    columns=["Issue", "Correction Applied", "Result"]
)

print(log_df.to_string(index=False))

